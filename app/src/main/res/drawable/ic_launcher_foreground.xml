        <!-- Torso, Arms and L-sit legs -->
        <!-- Arms pressing down to bars -->
        <path
            android:pathData="M46,43 L38,70"
            android:strokeWidth="4"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />
        <path
