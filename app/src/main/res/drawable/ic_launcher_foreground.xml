            android:strokeLineCap="round" />

        <!-- Torso -->
        <path
            android:pathData="M54,39 L54,61"
            android:strokeWidth="6"
            android:strokeColor="#00E5FF"
            android:strokeLineCap="round" />

        <!-- L-sit Extended Legs (horizontal forward hold) -->
        <path
            android:pathData="M54,61 L82,61"
            android:strokeWidth="5"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round" />

        <!-- Accent lightning energy dot -->
        <path
            android:pathData="M54,23 L56,26 L53,27 L55,30"
            android:strokeWidth="1.2"
            android:strokeColor="#00E5FF"
            android:strokeLineCap="round" />
